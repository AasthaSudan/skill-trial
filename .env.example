SKILLTRIAL_ENV=development
# Local preview of all content with a matching successful validation attestation.
# Does not apply outside development; false restores independent publication gates.
DEMO_CONTENT=true
APP_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./var/skilltrial.db
RUNNER_MODE=docker
RUNNER_URL=
RUNNER_HMAC_SECRET=
RUNNER_TIMEOUT=25
COOKIE_SECURE=false
REASSESS_COOLDOWN_H=24
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=SkillTrial <hello@skilltrial.local>
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Browser origin used for verification, reset, and report-share links
PUBLIC_APP_URL=http://127.0.0.1:5173
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
# Use runsc when the Docker host has the gVisor runtime installed
OCI_RUNTIME=runc
RUN_BACKGROUND_WORKER=true
# Optional AI. Choose gemini (Google AI Studio) or anthropic.
# Both env and admin switches plus candidate consent are required.
LLM_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Leave blank to use the official endpoint for the selected provider.
LLM_API_BASE_URL=
# Used for Anthropic, or as an alternative Gemini key variable.
LLM_API_KEY=
