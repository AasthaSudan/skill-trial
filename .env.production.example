# Copy this file to .env.production on the production host. Do not commit the copy.
APP_DOMAIN=skilltrial.example.com
APP_URL=https://skilltrial.example.com
PUBLIC_APP_URL=https://skilltrial.example.com
ALLOWED_ORIGINS=https://skilltrial.example.com
SKILLTRIAL_ENV=production
COOKIE_SECURE=true

POSTGRES_DB=skilltrial
POSTGRES_USER=skilltrial
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://skilltrial:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/skilltrial

# Reach this host only through a private network such as WireGuard.
RUNNER_MODE=remote
RUNNER_URL=http://10.20.0.2:8080
RUNNER_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RUNNER_TIMEOUT=25
OCI_RUNTIME=runsc

RUN_BACKGROUND_WORKER=true
REASSESS_COOLDOWN_H=24
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=SkillTrial <hello@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=

# Leave disabled until key, model, privacy notice, and provider terms are reviewed.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=https://api.anthropic.com
